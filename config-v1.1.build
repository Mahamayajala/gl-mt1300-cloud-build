# ============================================================
# GL-MT1300 云编译配置 - V1.1 (OpenWrt 25.12, 内核 6.12, 全官方 + LuCI 全功能)
# 在 V1 基础上:
#   + 全量 LuCI app (映射 GL UI 30 菜单功能, 替代 GL 闭源 UI)
#   + 保留 V1 全部: mtk_ppe 硬件加速 + WiFi/USB 全家桶 + GL 内核模块(源码)
#   + GL 用户态(shell/uci)迁移: network_gl/APN/monitor (workflow 注入)
#
# GL UI 菜单 -> LuCI 映射:
#   overview/internet/wireless/lanip/clients/logview/timezone/adminpw/upgrade/reset/advanced
#     = luci-mod-status/network/system + luci-app-* (原生)
#   firewallview/netnat = luci-app-firewall
#   dnsview = luci-app-dhcp | dynamicdns = luci-app-ddns
#   multiwan = luci-app-mwan3 | igmp = kmod-igmp
#   ovpnclient/server + vpndashboard = luci-app-openvpn | wgclient/server = luci-app-wireguard
#   modemmanage = luci-proto-qmi/3g/ppp | plugins = luci-app-opkg
#   macclone/bridge/ipv6 = luci-mod-network | timedtask = cron
# ============================================================

# ---------- 目标: GL.iNet GL-MT1300 ----------
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_glinet_gl-mt1300=y

# ---------- HNAT 硬件加速(PPE + flowtable, 25.12 内建 mtk_ppe) ----------
CONFIG_NET_MEDIATEK_SOC=y
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-ipt-offload=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nft-nat=y

# ---------- WiFi (主线 mt76, 原厂同源 mt7615e) ----------
CONFIG_PACKAGE_kmod-mt7615e=y
CONFIG_PACKAGE_kmod-mt7615-firmware=y
CONFIG_PACKAGE_kmod-mt7603=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y

# ---------- USB/4G 驱动 (移植 GL22 原厂全家桶) ----------
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-acm=y
CONFIG_PACKAGE_kmod-usb-wdm=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-mii=y

# ---------- USB/4G 拨号工具 (25.12 标准替代 gl-sdk4-modem) ----------
CONFIG_PACKAGE_comgt=y
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_wwan=y

# ---------- 文件系统(USB 存储) ----------
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fuse=y

# ---------- 基础组件 ----------
CONFIG_PACKAGE_uci=y
CONFIG_PACKAGE_ubus=y
CONFIG_PACKAGE_ubusd=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_libubus=y
CONFIG_PACKAGE_libubox=y
CONFIG_PACKAGE_libuci=y
CONFIG_PACKAGE_libjson-c=y
CONFIG_PACKAGE_libblobmsg-json=y
CONFIG_PACKAGE_libpthread=y
CONFIG_PACKAGE_libustream-mbedtls=y
CONFIG_PACKAGE_zlib=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_fstools=y
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_dnsmasq=y
CONFIG_PACKAGE_odhcpd=y
# CONFIG_PACKAGE_odhcpd-ipv6only is not set
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_ppp=y

# ---------- 防火墙(nftables, 支持 flowtable) ----------
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y

# ---------- LuCI 全功能 (映射 GL UI 30 菜单) ----------
CONFIG_PACKAGE_luci=y
# 状态/系统/网络 基础模块 (luci 已含 luci-mod-*, 显式确保)
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-mod-admin-full=y
# 功能 app: 防火墙/NAT
CONFIG_PACKAGE_luci-app-firewall=y
# DNS/DHCP
CONFIG_PACKAGE_luci-app-dhcp=y
# DDNS
CONFIG_PACKAGE_luci-app-ddns=y
# 多 WAN
CONFIG_PACKAGE_luci-app-mwan3=y
# OpenVPN 客户端/服务端 + VPN 总览
CONFIG_PACKAGE_luci-app-openvpn=y
# WireGuard 客户端/服务端
CONFIG_PACKAGE_luci-app-wireguard=y
# 插件管理 (软件包)
CONFIG_PACKAGE_luci-app-opkg=y
# 4G 调制解调器 UI (QMI/串口3G/PPP)
CONFIG_PACKAGE_luci-proto-qmi=y
CONFIG_PACKAGE_luci-proto-3g=y
CONFIG_PACKAGE_luci-proto-ppp=y
# 状态图/客户端 (可选项)
CONFIG_PACKAGE_luci-app-statistics=y
# 定时任务 (timedtask, cron 底层)
CONFIG_PACKAGE_luci-app-commands=y
CONFIG_PACKAGE_cron=y
# IGMP (igmp 菜单)
CONFIG_PACKAGE_kmod-igmp=y

# ---------- 基础 kmod ----------
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y

# ---------- GL.iNet SDK4 内核模块 (自编译源码, 可随内核升级) ----------
CONFIG_PACKAGE_kmod-gl-sdk4-hw-info=y
CONFIG_PACKAGE_kmod-gl-sdk4-tertf=y
